page {
  min-height: 100%;
  background: #f7f8fa;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page-shell {
  box-sizing: border-box;
  padding: 24rpx 28rpx 32rpx;
}

.card {
  background: #fff;
  border: 1rpx solid #edf0f5;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.04);
}

.muted {
  color: #718096;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0;
  box-sizing: border-box;
  color: #fff;
  background: #1677ff;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.primary-button::after {
  border: 0;
}

.tap-active {
  opacity: .78;
}


