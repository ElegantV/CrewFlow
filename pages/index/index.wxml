<navigation-bar title="简序日程" back="{{false}}" color="#1F2329" background="#F7F8FA"></navigation-bar>
<!-- 使用标准滚动属性，兼容 Skyline 与 WebView。 -->
<scroll-view class="scrollarea" scroll-y>
  <view class="page-shell home-page">
    <view class="hero card">
      <text class="eyebrow">团队工作台</text>
      <text class="hero-title">今天也要有条不紊</text>
      <text class="hero-subtitle" wx:if="{{user && user.status === 'active'}}">{{user.name ? user.name + '，欢迎回来' : '欢迎使用，请先在个人信息中完善资料'}}</text>
      <text class="hero-subtitle" wx:elif="{{user && user.status === 'pending'}}">账号待管理员激活，请先完善账号信息</text>
      <text class="hero-subtitle" wx:elif="{{user && user.status === 'disabled'}}">账号已停用，请联系管理员</text>
      <text class="hero-subtitle" wx:elif="{{user}}">登录状态异常，请重新登录</text>
      <text class="hero-subtitle" wx:elif="{{apiStatus === 'unavailable'}}">后端暂时不可用，请检查 API 服务</text>
      <text class="hero-subtitle" wx:elif="{{apiStatus === 'auth_required'}}">登录状态已失效，请重新登录</text>
      <text class="hero-subtitle" wx:elif="{{apiConfigured}}">正在连接团队账号</text>
      <text class="hero-subtitle" wx:else>部署后请配置 API 地址</text>
      <button wx:if="{{user && user.status === 'pending'}}" class="hero-button" bindtap="openRegister">完善账号</button>
    </view>

    <view class="reminder-stack" wx:if="{{reminders.overtimeExpiring.length || reminders.dutyConflicts.length || (user && (user.role === 'admin' || user.role === 'super_admin') && reminders.pendingApprovals > 0)}}">
      <view class="reminder-card reminder-card--orange" wx:if="{{reminders.overtimeExpiring.length}}" data-url="/pages/duty/index" bindtap="openShortcut" hover-class="tap-active" hover-stay-time="80">
        <view class="reminder-icon">调</view>
        <view class="reminder-body">
          <text class="reminder-title">调休即将到期</text>
          <text class="reminder-text">{{reminders.overtimeExpiring.length}} 笔调休额度将在 3 天内到期，请及时安排使用</text>
        </view>
        <text class="reminder-arrow">›</text>
      </view>
      <view class="reminder-card reminder-card--blue" wx:if="{{reminders.pendingApprovals > 0}}" data-url="/pages/approval/index" bindtap="openShortcut" hover-class="tap-active" hover-stay-time="80">
        <view class="reminder-icon">审</view>
        <view class="reminder-body">
          <text class="reminder-title">待审批申请</text>
          <text class="reminder-text">你有 {{reminders.pendingApprovals}} 条请假申请待处理</text>
        </view>
        <text class="reminder-arrow">›</text>
      </view>
      <view class="reminder-card reminder-card--red" wx:if="{{reminders.dutyConflicts.length}}" data-url="/pages/situation/index" bindtap="openShortcut" hover-class="tap-active" hover-stay-time="80">
        <view class="reminder-icon">值</view>
        <view class="reminder-body">
          <text class="reminder-title">值班时间冲突</text>
          <text class="reminder-text">{{reminders.dutyConflicts.length}} 天请假与已登记值班重叠，请确认安排</text>
        </view>
        <text class="reminder-arrow">›</text>
      </view>
    </view>

    <view class="section-title section-title--row">
      <text>常用功能</text>
      <text class="menu-edit-link" bindtap="openMenuEditor" wx:if="{{user && user.status === 'active'}}">编辑菜单</text>
    </view>
    <view class="shortcut-grid">
      <view
        wx:for="{{shortcuts}}"
        wx:key="key"
        class="shortcut shortcut--{{item.accent}}"
        data-url="{{item.url}}"
        bindtap="openShortcut"
        hover-class="tap-active"
        hover-stay-time="80"
      >
        <view class="shortcut-card card">
          <view class="shortcut-top">
            <view class="shortcut-icon"><image class="shortcut-icon-img" src="{{item.icon}}" mode="aspectFit"></image></view>
            <text class="shortcut-arrow">›</text>
          </view>
          <text class="shortcut-title">{{item.title}}</text>
          <text class="shortcut-description">{{item.description}}</text>
        </view>
      </view>
    </view>

    <view class="modal-mask {{menuClosing ? 'modal-mask--closing' : ''}}" wx:if="{{menuEditor}}" bindtap="closeMenuEditor">
      <view class="menu-sheet {{menuClosing ? 'menu-sheet--closing' : ''}}" catchtap="noopMenu">
        <view class="menu-sheet__handle"></view>
        <view class="menu-sheet__head">
          <text class="menu-sheet__title">编辑菜单</text>
          <view class="menu-sheet__close" bindtap="closeMenuEditor">✕</view>
        </view>
        <text class="menu-sheet__hint">关闭的入口不再显示在首页,箭头可调整顺序</text>
        <scroll-view class="menu-sheet__list" scroll-y>
          <view
            class="menu-item shortcut--{{item.accent}} {{item.hidden ? 'menu-item--hidden' : ''}}"
            wx:for="{{menuItems}}"
            wx:key="key"
          >
            <text class="menu-item__index">{{index + 1}}</text>
            <view class="shortcut-icon menu-item__icon">
              <image class="menu-item__icon-img" src="{{item.icon}}" mode="aspectFit"></image>
            </view>
            <view class="menu-item__copy">
              <text class="menu-item__name">{{item.title}}</text>
              <text class="menu-item__state">{{item.hidden ? '已隐藏' : '已显示'}}</text>
            </view>
            <view class="menu-item__actions">
              <switch class="menu-item__switch" checked="{{!item.hidden}}" data-key="{{item.key}}" bindchange="toggleMenuItem" color="{{switchColor}}" />
              <view class="menu-item__move {{index === 0 ? 'menu-item__move--disabled' : ''}}" data-index="{{index}}" data-direction="up" bindtap="moveMenuItem">↑</view>
              <view class="menu-item__move {{index === menuItems.length - 1 ? 'menu-item__move--disabled' : ''}}" data-index="{{index}}" data-direction="down" bindtap="moveMenuItem">↓</view>
            </view>
          </view>
        </scroll-view>
        <view class="menu-sheet__footer">
          <button class="menu-sheet__cancel" bindtap="closeMenuEditor">取消</button>
          <button class="menu-sheet__save" loading="{{menuSaving}}" bindtap="saveMenuEditor">保存</button>
        </view>
      </view>
    </view>

    <view class="setup-tip" wx:if="{{!apiConfigured || apiStatus === 'unavailable'}}">
      <text class="setup-tip__title">尚未连接后端</text>
      <text class="setup-tip__content" wx:if="{{!apiConfigured}}">请在 config/env.js 中填写云服务器的 HTTPS API 地址。</text>
      <text class="setup-tip__content" wx:else>请确认 API 服务已启动，并检查 config/env.js 中的地址。</text>
      <button class="retry-button" wx:if="{{apiStatus === 'unavailable'}}" bindtap="retryConnection">重新连接</button>
    </view>
  </view>
</scroll-view>
