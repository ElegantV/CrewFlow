page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  width: 100%;
  height: 0;
  box-sizing: border-box;
}

.home-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 38rpx 36rpx 40rpx;
  border-color: #dceaff;
  background: linear-gradient(145deg, #eaf3ff, #ffffff 75%);
}

.eyebrow {
  margin-bottom: 14rpx;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: #646a73;
  font-size: 26rpx;
}

.hero-button {
  align-self: flex-start;
  height: 64rpx;
  margin: 24rpx 0 0;
  padding: 0 32rpx;
  border-radius: 14rpx;
  color: #fff;
  background: #1677ff;
  font-size: 25rpx;
  line-height: 64rpx;
}

.hero-button::after {
  border: 0;
}

.section-title {
  margin: 40rpx 4rpx 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.shortcut-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: -12rpx;
}

.shortcut {
  width: 50%;
  flex: 0 0 50%;
  min-width: 0;
  padding: 12rpx;
  box-sizing: border-box;
}

.shortcut-card {
  display: flex;
  flex-direction: column;
  min-height: 226rpx;
  height: 100%;
  padding: 26rpx;
  box-sizing: border-box;
}

.shortcut-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.shortcut-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  color: #fff;
}

.shortcut-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.shortcut--blue .shortcut-icon {
  background: #2563eb;
}

.shortcut--green .shortcut-icon {
  background: #059669;
}

.shortcut--purple .shortcut-icon { background: #7c3aed; }
.shortcut--orange .shortcut-icon { background: #ea580c; }
.shortcut--red .shortcut-icon { background: #dc2626; }
.shortcut--slate .shortcut-icon { background: #475569; }
.shortcut--ai .shortcut-icon { background: linear-gradient(145deg, #246bfd, #7047eb); }

.shortcut-title {
  font-size: 30rpx;
  font-weight: 700;
}

.shortcut-description {
  margin-top: 10rpx;
  color: #8a9099;
  font-size: 22rpx;
  line-height: 1.5;
}

.setup-tip {
  display: flex;
  flex-direction: column;
  margin-top: 32rpx;
  padding: 28rpx;
  border: 1rpx solid #fde68a;
  border-radius: 20rpx;
  background: #fffbeb;
}

.setup-tip__title {
  color: #92400e;
  font-size: 28rpx;
  font-weight: 700;
}

.setup-tip__content {
  margin-top: 8rpx;
  color: #a16207;
  font-size: 24rpx;
  line-height: 1.5;
}

.retry-button {
  margin: 24rpx 0 0;
  border-radius: 14rpx;
  color: #92400e;
  background: #fde68a;
  font-size: 26rpx;
}

.retry-button::after {
  border: 0;
}
.shortcut-arrow {
  color: #b2b8c2;
  font-size: 36rpx;
  line-height: 1;
}

.reminder-stack {
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
  gap: 16rpx;
}

.reminder-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 24rpx;
  border: 1rpx solid transparent;
  border-radius: 18rpx;
}

.reminder-card--orange { border-color: #fde68a; background: #fffbeb; }
.reminder-card--blue { border-color: #bfdbfe; background: #eff6ff; }
.reminder-card--red { border-color: #fecaca; background: #fef2f2; }

.reminder-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.reminder-card--orange .reminder-icon { background: #ea580c; }
.reminder-card--blue .reminder-icon { background: #2563eb; }
.reminder-card--red .reminder-icon { background: #dc2626; }

.reminder-body {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.reminder-title {
  font-size: 27rpx;
  font-weight: 700;
}

.reminder-card--orange .reminder-title { color: #92400e; }
.reminder-card--blue .reminder-title { color: #1e40af; }
.reminder-card--red .reminder-title { color: #991b1b; }

.reminder-text {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.reminder-card--orange .reminder-text { color: #a16207; }
.reminder-card--blue .reminder-text { color: #1d4ed8; }
.reminder-card--red .reminder-text { color: #b91c1c; }

.reminder-arrow {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #b2b8c2;
  font-size: 34rpx;
  line-height: 1;
}
.section-title--row { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.menu-edit-link { color: #2f6fed; font-size: 24rpx; }
.menu-editor { width: 100%; padding: 36rpx 32rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #fff; box-sizing: border-box; }
.menu-editor__title { display: block; font-size: 36rpx; font-weight: 700; }
.menu-editor__hint { display: block; margin-top: 8rpx; margin-bottom: 16rpx; color: #64748b; font-size: 24rpx; }
.menu-editor__list { max-height: 60vh; overflow-y: auto; }
.menu-editor__item { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #eef2f7; }
.menu-editor__item--hidden .menu-editor__name { color: #94a3b8; text-decoration: line-through; }
.menu-editor__name { font-size: 28rpx; color: #1f2329; }
.menu-editor__actions { display: flex; flex-direction: row; align-items: center; transform: scale(0.8); }
.menu-editor__switch { transform: scale(0.8); }
.menu-editor__move { width: 56rpx; height: 56rpx; margin-left: 10rpx; border: 1rpx solid #d9e1ea; border-radius: 12rpx; color: #475569; font-size: 28rpx; text-align: center; line-height: 52rpx; background: #f8fafc; }
.menu-editor__footer { display: flex; flex-direction: row; margin-top: 28rpx; }
.menu-editor__footer button { flex: 1; margin: 0; }
.menu-editor__footer button + button { margin-left: 20rpx; }
.menu-editor__cancel { border-radius: 16rpx; color: #475569; background: #edf2f7; }
.menu-editor__cancel::after, .menu-editor__save::after { border: 0; }
