page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  width: 100%;
  height: 0;
  box-sizing: border-box;
}

.home-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 38rpx 36rpx 40rpx;
  border-color: #dceaff;
  background: linear-gradient(145deg, var(--c-brand-tint), #ffffff 75%);
}

.eyebrow {
  margin-bottom: 14rpx;
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: var(--c-text-sub);
  font-size: 26rpx;
}

.hero-button {
  align-self: flex-start;
  height: 64rpx;
  margin: 24rpx 0 0;
  padding: 0 32rpx;
  border-radius: var(--r-md);
  color: #fff;
  background: var(--brand);
  font-size: 25rpx;
  line-height: 64rpx;
}

.hero-button::after {
  border: 0;
}

.section-title {
  margin: 40rpx 4rpx 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.shortcut-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: -12rpx;
}

.shortcut {
  width: 50%;
  flex: 0 0 50%;
  min-width: 0;
  padding: 12rpx;
  box-sizing: border-box;
}

.shortcut-card {
  display: flex;
  flex-direction: column;
  min-height: 226rpx;
  height: 100%;
  padding: 26rpx;
  box-sizing: border-box;
  transition: transform .12s ease, box-shadow .2s ease;
}

.shortcut-card:active {
  transform: scale(.985);
}

.shortcut-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.shortcut-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--r-md);
  color: #fff;
}

.shortcut-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.shortcut--blue .shortcut-icon {
  background: var(--brand-deep);
}

.shortcut--green .shortcut-icon {
  background: #059669;
}

.shortcut--purple .shortcut-icon { background: #7c3aed; }
.shortcut--orange .shortcut-icon { background: #ea580c; }
.shortcut--red .shortcut-icon { background: var(--c-danger-strong); }
.shortcut--slate .shortcut-icon { background: #475569; }
.shortcut--ai .shortcut-icon { background: linear-gradient(145deg, var(--brand-ai-from), var(--brand-ai-to)); }

.shortcut-title {
  font-size: 30rpx;
  font-weight: 700;
}

.shortcut-description {
  margin-top: 10rpx;
  color: #8a9099;
  font-size: 22rpx;
  line-height: 1.5;
}

.setup-tip {
  display: flex;
  flex-direction: column;
  margin-top: 32rpx;
  padding: 28rpx;
  border: 1rpx solid #fde68a;
  border-radius: var(--r-lg);
  background: var(--c-warning-bg);
}

.setup-tip__title {
  color: var(--c-warning);
  font-size: 28rpx;
  font-weight: 700;
}

.setup-tip__content {
  margin-top: 8rpx;
  color: #a16207;
  font-size: 24rpx;
  line-height: 1.5;
}

.retry-button {
  margin: 24rpx 0 0;
  border-radius: var(--r-md);
  color: var(--c-warning);
  background: #fde68a;
  font-size: 26rpx;
}

.retry-button::after {
  border: 0;
}
.shortcut-arrow {
  color: #b2b8c2;
  font-size: 36rpx;
  line-height: 1;
}

.reminder-stack {
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
  gap: 16rpx;
}

.reminder-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 24rpx;
  border: 1rpx solid transparent;
  border-radius: var(--r-md);
}

.reminder-card--orange { border-color: #fde68a; background: var(--c-warning-bg); }
.reminder-card--blue { border-color: #bfdbfe; background: var(--c-info-bg); }
.reminder-card--red { border-color: #fecaca; background: var(--c-danger-bg); }

.reminder-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  border-radius: var(--r-md);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.reminder-card--orange .reminder-icon { background: #ea580c; }
.reminder-card--blue .reminder-icon { background: var(--brand-deep); }
.reminder-card--red .reminder-icon { background: var(--c-danger-strong); }

.reminder-body {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.reminder-title {
  font-size: 27rpx;
  font-weight: 700;
}

.reminder-card--orange .reminder-title { color: var(--c-warning); }
.reminder-card--blue .reminder-title { color: #1e40af; }
.reminder-card--red .reminder-title { color: #991b1b; }

.reminder-text {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.reminder-card--orange .reminder-text { color: #a16207; }
.reminder-card--blue .reminder-text { color: var(--c-info); }
.reminder-card--red .reminder-text { color: #b91c1c; }

.reminder-arrow {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #b2b8c2;
  font-size: 34rpx;
  line-height: 1;
}
.section-title--row { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.menu-edit-link { color: var(--brand-deep); font-size: 24rpx; }
.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(15, 23, 42, .5); animation: mask-fade .2s ease; }
.modal-mask--closing { animation: mask-fade .2s ease reverse forwards; }
@keyframes mask-fade { from { opacity: 0; } to { opacity: 1; } }
.menu-sheet { flex-shrink: 0; display: flex; flex-direction: column; width: 100%; max-height: 84vh; padding: 10rpx 30rpx 0; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); border-radius: var(--r-xl) var(--r-xl) 0 0; background: #fff; box-shadow: var(--shadow-pop); box-sizing: border-box; animation: sheet-rise .28s cubic-bezier(.32, .72, 0, 1); }
.menu-sheet--closing { animation: sheet-rise .2s cubic-bezier(.32, .72, 0, 1) reverse forwards; }
@keyframes sheet-rise { from { transform: translateY(100%); } to { transform: translateY(0); } }
.menu-sheet__handle { width: 72rpx; height: 8rpx; margin: 0 auto 20rpx; border-radius: var(--r-pill); background: #d8dce3; }
.menu-sheet__head { display: flex; flex-direction: row; flex-shrink: 0; align-items: center; justify-content: space-between; }
.menu-sheet__title { font-size: 34rpx; font-weight: 700; color: var(--c-text); }
.menu-sheet__close { padding: 0 0 0 24rpx; color: var(--c-text-faint); font-size: 30rpx; }
.menu-sheet__hint { display: block; flex-shrink: 0; margin-top: 8rpx; margin-bottom: 22rpx; color: var(--c-text-faint); font-size: 23rpx; }
.menu-sheet__list { flex: 1; min-height: 0; max-height: 52vh; }
.menu-item { display: flex; flex-direction: row; align-items: center; margin-bottom: 12rpx; padding: 16rpx 20rpx; border: 1rpx solid var(--c-border); border-radius: var(--r-md); background: var(--c-bg-card); box-sizing: border-box; }
.menu-item--hidden { background: var(--c-bg-subtle); }
.menu-item__index { flex: 0 0 auto; width: 26rpx; color: var(--c-text-faint); font-size: 22rpx; }
.menu-item__icon { flex: 0 0 auto; width: 52rpx; height: 52rpx; margin-left: 8rpx; }
.menu-item__icon-img { width: 30rpx; height: 30rpx; }
.menu-item--hidden .menu-item__icon { filter: grayscale(1); opacity: .4; }
.menu-item__copy { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 18rpx; }
.menu-item__name { font-size: 28rpx; font-weight: 500; color: var(--c-text); }
.menu-item--hidden .menu-item__name { color: var(--c-text-faint); text-decoration: line-through; }
.menu-item__state { margin-top: 4rpx; color: var(--c-text-faint); font-size: 20rpx; }
.menu-item--hidden .menu-item__state { color: var(--c-warning); }
.menu-item__actions { display: flex; flex: 0 0 auto; flex-direction: row; align-items: center; }
.menu-item__switch { flex: 0 0 auto; transform: scale(.8); margin: 0 -10rpx 0 0; }
.menu-item__move { display: flex; width: 64rpx; height: 64rpx; margin-left: 12rpx; align-items: center; justify-content: center; border: 1rpx solid var(--c-border); border-radius: 50%; background: var(--c-bg-card); color: #475569; font-size: 28rpx; transition: background-color .15s ease, opacity .15s ease; }
.menu-item__move:active { background: var(--c-neutral-bg); }
.menu-item__move--disabled { opacity: .28; }
.menu-sheet__footer { display: flex; flex-direction: row; flex-shrink: 0; margin-top: 22rpx; }
/* 微信 button 自带内边距与行高,在 flex 布局中会导致文字基线偏移;重置为 flex 居中,保证文字严格垂直居中。 */
.menu-sheet__footer button { flex: 1; margin: 0; padding: 0; height: 88rpx; line-height: normal; display: flex; align-items: center; justify-content: center; border-radius: var(--r-lg); font-size: 30rpx; }
.menu-sheet__footer button + button { margin-left: 20rpx; }
.menu-sheet__cancel { color: #475569; background: var(--c-neutral-bg); }
.menu-sheet__save { color: #fff; background: var(--brand-deep); }
.menu-sheet__cancel::after, .menu-sheet__save::after { border: 0; }
