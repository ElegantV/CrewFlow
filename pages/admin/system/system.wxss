page { height: 100vh; display: flex; flex-direction: column; }
.page-shell { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }

/* 超管功能双列入口:沿用首页快捷入口的「彩色图标块 + 标题 + 副标题」样式。
   卡片用 view 而非 button——button 自带 margin-left/right: auto,flex 换行后单卡会被推到行正中。 */
.system-grid { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: flex-start; margin: -10rpx; }
.admin-action { flex: 0 0 calc(50% - 20rpx); width: calc(50% - 20rpx); min-width: 0; margin: 10rpx; display: flex; flex-direction: column; align-items: flex-start; padding: 26rpx; box-sizing: border-box; }
.admin-action__icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: var(--r-md); }
.admin-action__icon--users { background: var(--c-danger-strong); }
.admin-action__icon--export { background: var(--c-success-fill); }
.admin-action__icon--calendar { background: var(--brand-deep); }
.admin-action__icon--dict { background: var(--brand-ai-to); }
.admin-action__img { width: 36rpx; height: 36rpx; }
.admin-action__title { margin-top: 16rpx; color: var(--c-text); font-size: 28rpx; font-weight: 700; }
.admin-action__desc { margin-top: 6rpx; color: var(--c-text-muted); font-size: 20rpx; line-height: 1.5; }

.form-card { width: 100%; padding: 36rpx 32rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); border-radius: var(--r-xl) var(--r-xl) 0 0; background: #fff; box-sizing: border-box; }
.form-title { display: block; margin-bottom: 20rpx; font-size: 32rpx; font-weight: 700; }
.label { display: block; margin-bottom: 10rpx; color: var(--c-text-on-neutral); font-size: 24rpx; }
.control { padding: 20rpx 22rpx; border: 1rpx solid var(--c-border-strong); border-radius: var(--r-md); background: var(--c-bg-subtle); font-size: 28rpx; }
.actions { display: flex; flex-direction: row; margin-top: 28rpx; }
/* 重置微信 button 默认内边距/行高,flex 居中避免文字垂直偏移。 */
.actions button { flex: 1; margin: 0; padding: 0; height: 88rpx; line-height: normal; display: flex; align-items: center; justify-content: center; border-radius: var(--r-lg); font-size: 28rpx; font-weight: 600; box-sizing: border-box; }
.actions button + button { margin-left: 20rpx; }
.secondary { border-radius: var(--r-md); color: var(--c-text-on-neutral); background: var(--c-neutral-bg); }
.secondary::after { border: 0; }
.export-hint { display: block; margin-bottom: 8rpx; color: #64748b; font-size: 24rpx; line-height: 1.5; }
