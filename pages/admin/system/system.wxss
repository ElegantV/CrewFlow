page { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; width: 100%; height: 0; box-sizing: border-box; }

/* 超管功能双列入口:沿用首页快捷入口的「彩色图标块 + 标题 + 副标题」样式 */
.system-grid { display: flex; flex-direction: row; flex-wrap: wrap; margin: -10rpx; }
.admin-action { flex: 0 0 calc(50% - 20rpx); width: calc(50% - 20rpx); min-width: 0; margin: 10rpx; display: flex; flex-direction: column; align-items: flex-start; padding: 26rpx; box-sizing: border-box; line-height: normal; }
.admin-action::after { border: 0; }
.admin-action__icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: var(--r-md); }
.admin-action__icon--users { background: var(--c-danger-strong); }
.admin-action__icon--export { background: #059669; }
.admin-action__icon--ai { background: linear-gradient(145deg, var(--brand-ai-from), var(--brand-ai-to)); }
.admin-action__icon--calendar { background: var(--brand-deep); }
.admin-action__img { width: 36rpx; height: 36rpx; }
.admin-action__title { margin-top: 16rpx; color: var(--c-text); font-size: 28rpx; font-weight: 700; }
.admin-action__desc { margin-top: 6rpx; color: var(--c-text-muted); font-size: 22rpx; line-height: 1.5; }

.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(15, 23, 42, .48); }
.form-card { width: 100%; padding: 36rpx 32rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); border-radius: var(--r-xl) var(--r-xl) 0 0; background: #fff; box-sizing: border-box; }
.form-title { display: block; margin-bottom: 20rpx; font-size: 36rpx; font-weight: 700; }
.field { margin-top: 20rpx; }
.label { display: block; margin-bottom: 10rpx; color: #475569; font-size: 24rpx; }
.control { padding: 20rpx 22rpx; border: 1rpx solid #d9e1ea; border-radius: var(--r-md); background: var(--c-bg-subtle); font-size: 27rpx; }
.actions { display: flex; flex-direction: row; margin-top: 28rpx; }
/* 重置微信 button 默认内边距/行高,flex 居中避免文字垂直偏移。 */
.actions button { flex: 1; margin: 0; padding: 0; height: 88rpx; line-height: normal; display: flex; align-items: center; justify-content: center; border-radius: var(--r-lg); font-size: 29rpx; font-weight: 600; box-sizing: border-box; }
.actions button + button { margin-left: 20rpx; }
.secondary { border-radius: var(--r-md); color: var(--c-text-on-neutral); background: var(--c-neutral-bg); }
.secondary::after { border: 0; }
.export-hint { display: block; margin-bottom: 8rpx; color: #64748b; font-size: 24rpx; line-height: 1.5; }
