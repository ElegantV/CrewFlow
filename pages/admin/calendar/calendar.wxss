page { height: 100vh; display: flex; flex-direction: column; }
.page-shell { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }

.year-bar { display: flex; flex-direction: row; align-items: center; justify-content: center; padding: 8rpx 0 24rpx; }
.year-nav { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; color: #455267; font-size: 40rpx; }
.year-text { margin: 0 30rpx; font-size: 32rpx; font-weight: 700; }

.day-list { display: flex; flex-direction: column; }
.day-card { display: flex; flex-direction: column; margin-bottom: 20rpx; padding: 26rpx 28rpx; }
.day-head { display: flex; align-items: center; justify-content: space-between; }
.day-date { font-size: 28rpx; font-weight: 700; }
.tag { padding: 6rpx 14rpx; border-radius: var(--r-pill); font-size: 20rpx; }
.tag--holiday { color: var(--c-danger, var(--c-danger-strong)); background: rgba(239, 68, 68, .1); }
.tag--makeup { color: var(--c-warning); background: var(--c-warning-bg); }
.meta { margin-top: 10rpx; color: var(--c-text-muted); font-size: 24rpx; }
.empty { padding: 40rpx 0; text-align: center; }
.empty-text { color: var(--c-text-muted); font-size: 24rpx; }

.action-button { margin-top: 26rpx; }
.hint { display: block; margin-top: 20rpx; color: var(--c-text-muted); font-size: 20rpx; line-height: 1.7; text-align: center; }

.form-card { width: 100%; padding: 36rpx 32rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); border-radius: var(--r-xl) var(--r-xl) 0 0; background: #fff; box-sizing: border-box; }
.form-title { display: block; margin-bottom: 20rpx; font-size: 32rpx; font-weight: 700; }
.label { display: block; margin-bottom: 10rpx; color: var(--c-text-on-neutral); font-size: 24rpx; }
.control { padding: 20rpx 22rpx; border: 1rpx solid var(--c-border-strong); border-radius: var(--r-md); background: var(--c-bg-subtle); font-size: 28rpx; }
.actions { display: flex; flex-direction: row; margin-top: 28rpx; }
.actions button { flex: 1; margin: 0; padding: 0; height: 88rpx; line-height: normal; display: flex; align-items: center; justify-content: center; border-radius: var(--r-lg); font-size: 28rpx; font-weight: 600; box-sizing: border-box; }
.actions button + button { margin-left: 20rpx; }
.secondary { border-radius: var(--r-md); color: var(--c-text-on-neutral); background: var(--c-neutral-bg); }
.secondary::after { border: 0; }

