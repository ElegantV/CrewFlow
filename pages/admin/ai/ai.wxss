page { height: 100vh; display: flex; flex-direction: column; }
.ai-config-scroll { flex: 1; width: 100%; height: 0; box-sizing: border-box; background: #F7F8FA; }
.page-shell { padding: 24rpx 28rpx calc(60rpx + env(safe-area-inset-bottom)); }
.card { padding: 28rpx; margin-bottom: 24rpx; border-radius: var(--r-lg); background: #fff; box-shadow: 0 5rpx 18rpx rgba(30, 45, 70, .05); }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.section-title { color: var(--c-text-strong); font-size: 28rpx; font-weight: 700; }
.section-tag { padding: 6rpx 13rpx; border-radius: var(--r-pill); color: #66758a; background: #f1f4f8; font-size: 20rpx; }
.field-textarea { min-height: 200rpx; }
.primary-button { margin-top: 12rpx; padding: 24rpx 0; border-radius: var(--r-md); color: #fff; background: var(--brand-deep); font-size: 28rpx; }
.save-button { width: 100%; }
.loading-state { display: flex; justify-content: center; padding: 200rpx 0; color: var(--c-text-muted); font-size: 24rpx; }
