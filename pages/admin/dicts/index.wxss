page { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; width: 100%; height: 0; box-sizing: border-box; }
.page-shell { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }

.dict-tabs { display: flex; margin: 24rpx 28rpx 0; padding: 6rpx; border-radius: var(--r-md); background: var(--c-neutral-bg); flex-shrink: 0; }
.dict-tab { flex: 1; padding: 14rpx 0; border-radius: var(--r-sm); color: var(--c-text-on-neutral); text-align: center; font-size: 26rpx; }
.dict-tab--active { color: var(--brand-deep); background: #fff; font-weight: 600; }

.dict-list { display: flex; flex-direction: column; }
.dict-card { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; padding: 26rpx 28rpx; }
.dict-card__meta { margin-top: 8rpx; color: var(--c-text-muted); font-size: 23rpx; }
.dict-card__main { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.dict-card__name { font-size: 29rpx; font-weight: 600; }
.dict-card__meta { margin-top: 8rpx; color: var(--c-text-muted); font-size: 23rpx; }
.dict-card__actions { display: flex; flex-shrink: 0; align-items: center; margin-left: 20rpx; }
.dict-action { padding: 12rpx 8rpx 12rpx 24rpx; color: var(--brand-deep); font-size: 24rpx; }
.dict-action--danger { color: var(--c-danger); }
.dict-empty { padding: 72rpx 24rpx; color: var(--c-text-muted); text-align: center; }

/* 行内项目:左侧处室栏 + 右侧项目列表,点击处室联动切换 */
.dict-split { flex: 1; width: 100%; height: 0; display: flex; flex-direction: row; box-sizing: border-box; }
.dict-split__left { flex: 0 0 200rpx; width: 200rpx; border-right: 1rpx solid var(--c-border); background: var(--c-bg-subtle); box-sizing: border-box; }
.dict-split__right { flex: 1; min-width: 0; box-sizing: border-box; }
.dict-split__scroll { height: 100%; }
.dict-split__dept { padding: 28rpx 22rpx; color: var(--c-text-on-neutral); font-size: 25rpx; line-height: 1.4; }
.dict-split__dept--active { color: var(--brand-deep); background: #fff; font-weight: 600; border-left: 6rpx solid var(--brand-deep); }
.dict-split__hint { padding: 32rpx 20rpx; color: var(--c-text-faint); font-size: 22rpx; }
.dict-split__body { padding: 24rpx 24rpx 32rpx; }

.dict-footer { margin-top: 24rpx; }
.dict-add { width: 100%; box-sizing: border-box; }

.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(15, 23, 42, .48); }
.form-card { width: 100%; max-height: 88vh; overflow: hidden; border-radius: var(--r-xl) var(--r-xl) 0 0; background: #fff; box-sizing: border-box; }
.form-scroll { width: 100%; max-height: 88vh; }
.form-content { padding: 36rpx 32rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.form-title { display: block; margin-bottom: 20rpx; font-size: 36rpx; font-weight: 700; }
.field { margin-top: 20rpx; }
.label { display: block; margin-bottom: 10rpx; color: #475569; font-size: 24rpx; }
.control { padding: 20rpx 22rpx; border: 1rpx solid #d9e1ea; border-radius: var(--r-md); background: var(--c-bg-subtle); font-size: 27rpx; }
.picker-arrow { float: right; color: var(--c-text-faint); font-size: 30rpx; }
.actions { display: flex; flex-direction: row; margin-top: 28rpx; }
.actions button { flex: 1; margin: 0; padding: 0; height: 88rpx; line-height: normal; display: flex; align-items: center; justify-content: center; border-radius: var(--r-lg); font-size: 29rpx; font-weight: 600; box-sizing: border-box; }
.actions button + button { margin-left: 20rpx; }
.secondary { border-radius: var(--r-md); color: var(--c-text-on-neutral); background: var(--c-neutral-bg); }
.secondary::after { border: 0; }
.danger-help { display: block; margin-top: 18rpx; color: var(--c-danger); font-size: 21rpx; line-height: 1.6; }
.loading { padding: 72rpx 24rpx; color: var(--c-text-muted); text-align: center; }