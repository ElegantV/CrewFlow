page { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; width: 100%; height: 0; box-sizing: border-box; }
.warning { margin-bottom: 24rpx; padding: 20rpx 24rpx; border-radius: var(--r-md); color: var(--c-warning); background: var(--c-warning-bg); font-size: 24rpx; line-height: 1.5; }
.current { display: flex; flex-direction: column; padding: 28rpx; }
.current-label { color: var(--c-text-muted); font-size: 22rpx; }
.current-name { margin-top: 8rpx; font-size: 32rpx; font-weight: 700; }
.current-role { margin-top: 8rpx; color: var(--brand-deep); font-size: 23rpx; }
.user-list { display: flex; flex-direction: column; margin-top: 24rpx; }
.user-card { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; padding: 24rpx; }
.user-info { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.user-name { font-size: 28rpx; font-weight: 700; }
.user-meta { margin-top: 7rpx; color: var(--c-text-muted); font-size: 22rpx; }
.switch-button { flex-shrink: 0; margin: 0 0 0 20rpx; padding: 0 24rpx; border-radius: var(--r-md); color: var(--brand-deep); background: var(--c-info-bg); font-size: 24rpx; }
.switch-button::after { border: 0; }
.restore-button { margin-top: 32rpx; border-radius: var(--r-md); color: #fff; background: #475569; }
.restore-button::after { border: 0; }
.loading { padding: 64rpx; color: var(--c-text-muted); text-align: center; }
