<navigation-bar title="完善账号" back="{{false}}" color="#1F2329" background="#F7F8FA"></navigation-bar>
<view class="page-shell register-page">
  <view class="register-head">
    <text class="register-title">欢迎使用简序日程</text>
    <text class="register-sub">首次登录需完善账号信息，提交后即可使用</text>
  </view>

  <view class="tabs" wx:if="{{!registered}}">
    <view class="tab {{mode === 'register' ? 'tab--active' : ''}}" data-mode="register" bindtap="switchMode">注册新账号</view>
    <view class="tab {{mode === 'bind' ? 'tab--active' : ''}}" data-mode="bind" bindtap="switchMode">绑定已有用户</view>
  </view>

  <view class="form card" wx:if="{{!registered && mode === 'register'}}">
    <view class="field">
      <text class="field-label">姓名</text>
      <input class="field-input" value="{{form.name}}" placeholder="请输入真实姓名" maxlength="80" data-field="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input class="field-input" type="number" value="{{form.mobile}}" placeholder="请输入手机号" maxlength="30" data-field="mobile" bindinput="onInput" />
    </view>
    <button class="primary-button submit-button" loading="{{submitting}}" bindtap="submitRegister">提交注册</button>
    <text class="form-tip">提交后即可正常使用</text>
  </view>

  <view class="form card" wx:if="{{!registered && mode === 'bind'}}">
    <view class="field">
      <text class="field-label">姓名</text>
      <input class="field-input" value="{{bindForm.name}}" placeholder="请输入已注册的姓名" maxlength="80" data-field="name" bindinput="onBindInput" />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input class="field-input" type="number" value="{{bindForm.mobile}}" placeholder="请输入已注册的手机号" maxlength="30" data-field="mobile" bindinput="onBindInput" />
    </view>
    <button class="primary-button submit-button" loading="{{submitting}}" bindtap="submitBind">绑定并登录</button>
    <text class="form-tip">姓名 + 手机号均匹配即可绑定已有账号</text>
  </view>

  <view class="result card" wx:if="{{registered}}">
    <text class="result-title">已提交</text>
    <text class="result-text">账号信息已提交，请退出后重新打开小程序登录。</text>
  </view>
</view>
