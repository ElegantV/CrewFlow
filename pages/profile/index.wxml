<navigation-bar title="个人信息" color="#1F2329" background="#F7F8FA" customBack="{{true}}" bind:back="onNavBack"></navigation-bar>
<scroll-view class="profile-scroll" scroll-y>
  <view class="page-shell profile-page" wx:if="{{form}}">
    <view class="identity-card card">
      <button class="avatar-button" bindtap="chooseAvatar">
        <image wx:if="{{form.avatar}}" class="avatar" src="{{form.avatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar avatar--empty">头像</view>
      </button>
      <view class="identity-copy">
        <text class="identity-name">{{form.name || '未填写姓名'}}</text>
        <text class="identity-meta">{{personnelTypes[personnelTypeIndex].label}} · {{profile.manager ? '审批人 ' + profile.manager.name : '未配置审批人'}}</text>
        <text class="avatar-help">点击头像可更换</text>
      </view>
    </view>

    <view class="section-card card">
      <view class="section-head"><text class="section-title">账户信息</text><text class="section-tag">基础资料</text></view>
      <view class="field">
        <text class="field-label">中文姓名 <text class="required">*</text></text>
        <input class="field-control" value="{{form.name}}" data-field="name" bindinput="onInput" maxlength="80" placeholder="请输入中文姓名" />
      </view>
      <view class="field">
        <text class="field-label">账号</text>
        <input class="field-control" value="{{form.accountName}}" data-field="accountName" bindinput="onInput" maxlength="64" placeholder="请输入登录或内部账号" />
      </view>
      <view class="field">
        <text class="field-label">内网 OA 账号</text>
        <input class="field-control" value="{{form.oaAccount}}" data-field="oaAccount" bindinput="onInput" maxlength="64" placeholder="请输入内网 OA 账号" />
      </view>
      <view class="field">
        <text class="field-label">身份证</text>
        <input class="field-control" type="idcard" value="{{form.idCardNo}}" data-field="idCardNo" bindinput="onInput" maxlength="18" placeholder="请输入身份证号" />
        <text class="field-help field-help--privacy">敏感信息，仅用于内部人员资料管理。</text>
      </view>
    </view>

    <view class="section-card card">
      <view class="section-head"><text class="section-title">行内管理信息</text><text class="section-tag">组织与权限</text></view>
      <view class="field">
        <text class="field-label">人员类型 <text class="required">*</text></text>
        <picker range="{{personnelTypes}}" range-key="label" value="{{personnelTypeIndex}}" bindchange="onPersonnelTypeChange">
          <view class="field-control field-picker">{{personnelTypes[personnelTypeIndex].label}}<text class="picker-arrow">›</text></view>
        </picker>
      </view>
      <view class="field" wx:if="{{form.personnelType === 'digital'}}">
        <text class="field-label">数科员工号</text>
        <input class="field-control" value="{{form.digitalEmployeeNo}}" data-field="digitalEmployeeNo" bindinput="onInput" maxlength="64" placeholder="请输入数科员工号" />
      </view>
      <view class="field">
        <text class="field-label">行内处室</text>
        <picker range="{{departments}}" range-key="name" value="{{departmentIndex}}" bindchange="onDepartmentChange">
          <view class="field-control field-picker {{departments[departmentIndex] ? '' : 'field-placeholder'}}">{{departments[departmentIndex] ? departments[departmentIndex].name : '请选择行内处室'}}<text class="picker-arrow">›</text></view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">对应行内项目</text>
        <picker range="{{projectOptions}}" range-key="name" value="{{projectIndex}}" bindchange="onProjectChange" disabled="{{!projectOptions.length}}">
          <view class="field-control field-picker {{projectOptions[projectIndex] ? '' : 'field-placeholder'}}">{{projectOptions[projectIndex] ? projectOptions[projectIndex].name : '请先选择行内处室'}}<text class="picker-arrow">›</text></view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">对应审批人（管理员）</text>
        <picker mode="multiSelector" range="{{managerMultiRange}}" range-key="name" value="{{managerMultiIndex}}" bindchange="onManagerMultiChange" bindcolumnchange="onManagerMultiColumnChange">
          <view class="field-control field-picker">
            <text class="{{selectedManagerIndex >= 0 || profile.manager ? '' : 'field-placeholder'}}">{{selectedManagerIndex >= 0 ? filteredManagers[selectedManagerIndex].name : (profile.manager ? profile.manager.name : '请选择审批人')}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <text class="field-help" wx:if="{{!managers.length}}">暂无可选审批人，请联系超级管理员分配审批关系。</text>
        <text class="field-help" wx:else>先选处室，再选该处室的审批管理员。</text>
      </view>
      <view class="field" wx:if="{{form.personnelType !== 'bank'}}">
        <text class="field-label">工作代理人（非行员） <text class="required">*</text></text>
        <picker mode="multiSelector" range="{{agentMultiRange}}" range-key="name" value="{{agentMultiIndex}}" bindchange="onAgentMultiChange" bindcolumnchange="onAgentMultiColumnChange">
          <view class="field-control field-picker">
            <text class="{{selectedAgentIndex >= 0 || profile.agent ? '' : 'field-placeholder'}}">{{selectedAgentIndex >= 0 ? filteredPeople[selectedAgentIndex].name : (profile.agent ? profile.agent.name : '请选择非行员代理人')}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">打卡地点</text>
        <picker range="{{locations}}" range-key="name" value="{{locationIndex}}" bindchange="onLocationChange">
          <view class="field-control field-picker {{locations[locationIndex] ? '' : 'field-placeholder'}}">{{locations[locationIndex] ? locations[locationIndex].name : '请选择打卡地点'}}<text class="picker-arrow">›</text></view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">行内级别</text>
        <view class="field-control field-picker" bindtap="onBankLevelTap">
          <text>{{form.bankLevel || '初级'}}</text>
          <text class="picker-arrow">›</text>
        </view>
        <text class="field-help">行内级别默认为初级，如需调整请联系管理员。</text>
      </view>
      <view class="field">
        <text class="field-label">ITL 开通情况</text>
        <picker range="{{itlOptions}}" range-key="label" value="{{itlIndex}}" bindchange="onItlChange">
          <view class="field-control field-picker">{{itlOptions[itlIndex].label}}<text class="picker-arrow">›</text></view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">社保 / 工作开始时间</text>
        <picker mode="date" value="{{form.workStartDate}}" end="{{maxWorkStartDate}}" bindchange="onWorkStartDateChange">
          <view class="field-control field-picker {{form.workStartDate ? '' : 'field-placeholder'}}">{{form.workStartDate || '请选择开始日期'}}<text class="picker-arrow">›</text></view>
        </picker>
        <view class="annual-leave-tip">
          <text class="annual-leave-title">年假天数：{{annualLeave.annualLeaveDays}} 天</text>
          <text class="annual-leave-copy">只保留整数位，不满一天不计入；当前工作已满 {{annualLeave.workYears}} 年。</text>
        </view>
      </view>
    </view>

    <view class="section-card card">
      <view class="section-head"><text class="section-title">联系信息</text><text class="section-tag">日常联系</text></view>
      <view class="field">
        <text class="field-label">常用手机号</text>
        <input class="field-control" type="number" value="{{form.mobile}}" data-field="mobile" bindinput="onInput" maxlength="30" placeholder="请输入常用手机号" />
      </view>
      <view class="field">
        <text class="field-label">住址</text>
        <textarea class="field-control field-textarea" value="{{form.address}}" data-field="address" bindinput="onInput" maxlength="300" placeholder="请输入常住地址"></textarea>
      </view>
    </view>

    <view class="section-card card">
      <view class="section-head"><text class="section-title">紧急联系人</text><text class="section-tag">应急使用</text></view>
      <view class="field">
        <text class="field-label">姓名</text>
        <input class="field-control" value="{{form.emergencyContactName}}" data-field="emergencyContactName" bindinput="onInput" maxlength="80" placeholder="请输入紧急联系人姓名" />
      </view>
      <view class="field">
        <text class="field-label">电话</text>
        <input class="field-control" type="number" value="{{form.emergencyContactPhone}}" data-field="emergencyContactPhone" bindinput="onInput" maxlength="30" placeholder="请输入紧急联系人电话" />
      </view>
    </view>

    <view class="section-card card" wx:if="{{wxpusherEnabled}}">
      <view class="section-head">
        <text class="section-title">消息推送</text>
        <text class="signature-state {{wxpusherBound ? 'signature-state--saved' : ''}}">{{wxpusherBound ? '已绑定' : '未绑定'}}</text>
      </view>
      <text class="field-help">绑定后，请假审批等消息将通过微信服务号推送到你的微信，不再受一次性订阅限制。</text>

      <view class="wxpusher-bound" wx:if="{{wxpusherBound}}">
        <view class="wxpusher-uid">已绑定 UID：{{wxpusherUid}}</view>
        <view class="wxpusher-actions">
          <button class="text-button" bindtap="testPush">发送提醒消息</button>
          <button class="text-button-danger" bindtap="unbindPush">解绑</button>
        </view>
      </view>

      <view class="wxpusher-bind" wx:else>
        <view class="wxpusher-tip">点击"扫码绑定"后，用另一台设备微信扫一扫关注服务号，绑定后自动生效</view>
        <button class="primary-button" bindtap="getBindQr">{{wxpusherLoading ? '获取二维码…' : '扫码绑定'}}</button>
      </view>
    </view>

    <view class="section-card card" wx:if="{{isManager}}">
      <view class="section-head">
        <text class="section-title">审批签名</text>
        <text class="signature-state {{profile.signatureConfigured ? 'signature-state--saved' : ''}}">{{profile.signatureConfigured ? '已保存' : '未设置'}}</text>
      </view>
      <text class="field-help">通过申请时保存当次签名快照，并用于申请人下载的 PDF。</text>
      <view class="signature-preview" wx:if="{{signatureImage}}">
        <image class="signature-preview-img" src="{{signatureImage}}" mode="aspectFit"></image>
        <text class="signature-preview-label">当前签名</text>
      </view>
      <canvas class="signature-canvas" canvas-id="signatureCanvas" disable-scroll="true" catchtouchstart="onSignatureStart" catchtouchmove="onSignatureMove" catchtouchend="onSignatureEnd" catchtouchcancel="onSignatureEnd"></canvas>
      <view class="signature-actions">
        <button class="secondary-button" bindtap="clearSignature">清空重写</button>
        <button class="primary-button" loading="{{savingSignature}}" bindtap="saveSignature">保存签名</button>
      </view>
    </view>
  </view>
  <view class="loading-state" wx:else>正在加载个人信息…</view>
</scroll-view>

<view class="save-bar" wx:if="{{form}}">
  <button class="primary-button save-button" loading="{{saving}}" bindtap="saveProfile">保存个人信息</button>
</view>
