page { height: 100vh; display: flex; flex-direction: column; background: #f5f7fa; }
.profile-scroll { flex: 1; width: 100%; height: 0; }
.profile-page { padding-bottom: 28rpx; }
.identity-card { display: flex; align-items: center; padding: 18rpx 28rpx; background: linear-gradient(135deg, #eef6ff 0%, #fff 65%); }
.avatar-button { position: relative; overflow: hidden; flex: 0 0 28%; min-width: 0; margin: 0; padding: 0; border-radius: 24rpx; background: transparent; line-height: normal; }
.avatar-button::before { content: ''; display: block; padding-top: 100%; }
.avatar-button::after { border: 0; }
.avatar-button--disabled { opacity: .6; }
.avatar { position: absolute; top: 0; left: 0; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; border-radius: 24rpx; box-sizing: border-box; }
.avatar--empty { color: #fff; background: linear-gradient(145deg, #4f8cff, #2563eb); font-size: 40rpx; font-weight: 700; }
.identity-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 100rpx; }
.identity-name { color: #172033; font-size: 34rpx; font-weight: 700; line-height: 1.3; }
.identity-meta { margin-top: 6rpx; color: #526173; font-size: 23rpx; line-height: 1.4; }
.avatar-help { margin-top: 5rpx; color: #8a96a6; font-size: 20rpx; }
.section-card { margin-top: 22rpx; padding: 28rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4rpx; }
.section-title { color: #172033; font-size: 30rpx; font-weight: 700; }
.section-tag { padding: 6rpx 13rpx; border-radius: 999rpx; color: #66758a; background: #f1f4f8; font-size: 20rpx; }
.field { margin-top: 25rpx; }
.field-label { display: block; margin-bottom: 11rpx; color: #455267; font-size: 24rpx; font-weight: 500; }
.required { color: #ef4444; }
.field-control { width: 100%; min-height: 82rpx; padding: 20rpx 22rpx; border: 1rpx solid #dce3ec; border-radius: 15rpx; color: #172033; background: #f9fafc; font-size: 27rpx; box-sizing: border-box; }
.field-picker { display: flex; align-items: center; justify-content: space-between; }
.picker-arrow { color: #9aa5b3; font-size: 36rpx; line-height: 1; }
.field-placeholder { color: #9aa5b3; }
.field-control--readonly { color: #64748b; background: #f1f4f7; }
.field-textarea { height: 144rpx; }
.field-help { display: block; margin-top: 9rpx; color: #7b8797; font-size: 21rpx; line-height: 1.5; }
.field-help--privacy { color: #9a6b25; }
.annual-leave-tip { display: flex; flex-direction: column; margin-top: 13rpx; padding: 18rpx 20rpx; border: 1rpx solid #cdebdc; border-radius: 14rpx; background: #f0fbf6; }
.annual-leave-title { color: #147a55; font-size: 25rpx; font-weight: 700; }
.wxpusher-bound { margin-top: 18rpx; }
.wxpusher-uid { color: #2f6f4f; font-size: 24rpx; }
.wxpusher-actions { display: flex; align-items: center; margin-top: 18rpx; }
.wxpusher-actions button + button { margin-left: 18rpx; }
.text-button-danger { margin: 0; padding: 0 12rpx; color: #dc2626; background: transparent; font-size: 24rpx; }
.text-button-danger::after { border: 0; }
.wxpusher-bind { display: flex; flex-direction: column; align-items: center; margin-top: 20rpx; }
.wxpusher-tip { margin-top: 14rpx; color: #8a96a6; font-size: 22rpx; line-height: 1.6; }
.wxpusher-bind .primary-button { width: 100%; margin-top: 22rpx; }
.annual-leave-copy { margin-top: 7rpx; color: #4c7b68; font-size: 21rpx; line-height: 1.5; }
.signature-state { padding: 6rpx 14rpx; border-radius: 999rpx; color: #92400e; background: #fffbeb; font-size: 21rpx; }
.signature-state--saved { color: #047857; background: #ecfdf5; }
.signature-canvas { width: 100%; height: 220rpx; margin-top: 22rpx; border: 2rpx dashed #cbd5e1; border-radius: 16rpx; background: #fff; box-sizing: border-box; }
.signature-actions { display: flex; flex-direction: row; margin-top: 20rpx; }
.signature-actions button { flex: 1; margin: 0; }
.signature-actions button + button { margin-left: 18rpx; }
.secondary-button { border-radius: 16rpx; color: #475569; background: #edf2f7; }
.secondary-button::after { border: 0; }
.save-bar { flex-shrink: 0; padding: 14rpx 28rpx; padding-bottom: calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8edf3; background: rgba(255, 255, 255, .96); box-sizing: border-box; }
.save-button { width: 100%; margin: 0; }
.loading-state { padding: 120rpx 30rpx; color: #718096; text-align: center; }
