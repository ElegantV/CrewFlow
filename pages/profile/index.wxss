page { height: 100vh; display: flex; flex-direction: column; background: var(--c-bg); }
.profile-scroll { flex: 1; width: 100%; height: 0; }
.profile-page { padding-bottom: 28rpx; }
.identity-card { display: flex; align-items: center; padding: 18rpx 28rpx; background: linear-gradient(135deg, #eef6ff 0%, #fff 65%); }
.avatar-button { position: relative; overflow: hidden; flex: 0 0 28%; min-width: 0; margin: 0; padding: 0; border-radius: var(--r-lg); background: transparent; line-height: normal; }
.avatar-button::before { content: ''; display: block; padding-top: 100%; }
.avatar-button::after { border: 0; }
.avatar-button--disabled { opacity: .6; }
.avatar { position: absolute; top: 0; left: 0; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; border-radius: var(--r-lg); box-sizing: border-box; }
.avatar--empty { color: #fff; background: linear-gradient(145deg, var(--brand), var(--brand-deep)); font-size: 40rpx; font-weight: 700; }
.identity-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 100rpx; }
.identity-name { color: var(--c-text-strong); font-size: 32rpx; font-weight: 700; line-height: 1.3; }
.identity-meta { margin-top: 6rpx; color: #526173; font-size: 24rpx; line-height: 1.4; }
.avatar-help { margin-top: 5rpx; color: var(--c-text-muted); font-size: 20rpx; }
.section-card { margin-top: 22rpx; padding: 28rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4rpx; }
.section-title { color: var(--c-text-strong); font-size: 28rpx; font-weight: 700; }
.section-tag { padding: 6rpx 13rpx; border-radius: var(--r-pill); color: #66758a; background: #f1f4f8; font-size: 20rpx; }
.required { color: var(--c-danger-strong); }
.field-control--readonly { color: #64748b; background: #f1f4f7; }
.field-textarea { height: 144rpx; }
.field-help--privacy { color: #9a6b25; }
.annual-leave-tip { display: flex; flex-direction: column; margin-top: 13rpx; padding: 18rpx 20rpx; border: 1rpx solid var(--c-success-bg-strong); border-radius: var(--r-md); background: var(--c-success-bg); }
.annual-leave-title { color: var(--c-success); font-size: 24rpx; font-weight: 700; }
.wxpusher-bound { margin-top: 18rpx; }
.wxpusher-uid { color: var(--c-success); font-size: 24rpx; }
.wxpusher-actions { display: flex; align-items: center; margin-top: 18rpx; }
.wxpusher-actions button + button { margin-left: 18rpx; }
.text-button { color: var(--brand-deep); }
.text-button-danger { margin: 0; padding: 0 12rpx; color: var(--c-danger); background: transparent; font-size: 24rpx; }
.text-button-danger::after { border: 0; }
.wxpusher-bind { display: flex; flex-direction: column; align-items: center; margin-top: 20rpx; }
.wxpusher-tip { margin-top: 14rpx; color: var(--c-text-muted); font-size: 20rpx; line-height: 1.6; }
.wxpusher-bind .primary-button { width: 100%; margin-top: 22rpx; }
.annual-leave-copy { margin-top: 7rpx; color: var(--c-success); font-size: 20rpx; line-height: 1.5; }
.signature-state { padding: 6rpx 14rpx; border-radius: var(--r-pill); color: var(--c-warning); background: var(--c-warning-bg); font-size: 20rpx; }
.signature-state--saved { color: var(--c-success); background: var(--c-success-bg); }
.signature-canvas { width: 100%; height: 220rpx; margin-top: 22rpx; border: 2rpx dashed var(--c-border-strong); border-radius: var(--r-md); background: #fff; box-sizing: border-box; }
.signature-preview { display: flex; flex-direction: column; margin-top: 22rpx; padding: 18rpx; border: 1rpx solid var(--c-border); border-radius: var(--r-md); background: #fff; box-sizing: border-box; }
.signature-preview-img { width: 100%; height: 140rpx; }
.signature-preview-label { margin-top: 8rpx; color: var(--c-text-muted); font-size: 20rpx; text-align: center; }
.signature-actions { display: flex; flex-direction: row; margin-top: 20rpx; }
.signature-actions button { flex: 1; margin: 0; }
.signature-actions button + button { margin-left: 18rpx; }
.save-bar { flex-shrink: 0; padding: 14rpx 28rpx; padding-bottom: calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--c-border); background: rgba(255, 255, 255, .96); box-sizing: border-box; }
.save-button { width: 100%; margin: 0; }
.loading-state { padding: 120rpx 30rpx; color: var(--c-text-muted); text-align: center; }
