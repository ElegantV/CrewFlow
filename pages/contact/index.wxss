page { height: 100vh; display: flex; flex-direction: column; background: #f5f7fa; }
.contact-layout { display: flex; flex: 1; min-height: 0; border-top: 1rpx solid #e7ebf0; }
.system-list { flex-shrink: 0; width: 184rpx; height: 100%; background: #fff; }
.system-item { position: relative; display: flex; min-height: 96rpx; align-items: center; padding: 18rpx 20rpx; color: #4b5565; font-size: 24rpx; font-weight: 600; box-sizing: border-box; }
.system-item--active { color: #1677ff; background: #edf5ff; }
.system-indicator { position: absolute; top: 24rpx; bottom: 24rpx; left: 0; width: 6rpx; border-radius: 0 6rpx 6rpx 0; background: transparent; }
.system-item--active .system-indicator { background: #1677ff; }
.contact-panel { display: flex; flex: 1; min-width: 0; flex-direction: column; padding: 18rpx 16rpx; box-sizing: border-box; }
.panel-head { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; padding: 6rpx 4rpx 20rpx; }
.panel-title { color: #172033; font-size: 30rpx; font-weight: 700; }
.panel-subtitle { margin-left: 12rpx; color: #8a96a6; font-size: 21rpx; }
.panel-tip { color: #9aa5b3; font-size: 19rpx; }
.contact-list { flex: 1; width: 100%; height: 0; }
.contact-card { position: relative; width: 100%; min-height: 144rpx; margin-bottom: 14rpx; padding: 22rpx 154rpx 22rpx 20rpx; border: 1rpx solid #e8edf3; border-radius: 18rpx; background: #fff; box-shadow: 0 5rpx 16rpx rgba(31, 35, 41, .035); box-sizing: border-box; }
.contact-main { display: flex; width: 100%; min-width: 0; flex-direction: column; }
.contact-name-row { display: flex; align-items: center; }
.contact-name { overflow: hidden; color: #172033; font-size: 27rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.type-tag { flex-shrink: 0; margin-left: 9rpx; padding: 4rpx 9rpx; border-radius: 8rpx; color: #475569; background: #edf2f7; font-size: 18rpx; }
.type-tag--bank { color: #1d4ed8; background: #dbeafe; }
.type-tag--digital { color: #047857; background: #d1fae5; }
.type-tag--vendor { color: #a16207; background: #fef3c7; }
.contact-system, .contact-mobile { overflow: hidden; margin-top: 8rpx; color: #748196; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.contact-mobile { color: #526173; }
.contact-actions { position: absolute; top: 50%; right: 10rpx; display: flex; width: 136rpx; transform: translateY(-50%); }
.icon-button { display: flex; width: 66rpx; height: 88rpx; flex-direction: column; align-items: center; justify-content: center; margin: 0; padding: 0; color: #1677ff; background: transparent; font-size: 17rpx; line-height: 1.2; }
.icon-button + .icon-button { margin-left: 4rpx; }
.icon-button::after { border: 0; }
.icon-button--disabled { color: #b7c0cc; opacity: .45; }
.icon-shell { display: flex; width: 50rpx; height: 50rpx; align-items: center; justify-content: center; margin-bottom: 7rpx; border-radius: 50%; background: #edf5ff; }
.action-icon { width: 31rpx; height: 31rpx; }
.empty { padding: 100rpx 20rpx; color: #8a96a6; text-align: center; }
.page-state { display: flex; flex: 1; align-items: center; justify-content: center; color: #718096; font-size: 24rpx; }
.page-state--error { flex-direction: column; color: #b42318; }
.page-state button { margin-top: 20rpx; color: #1677ff; background: #edf5ff; font-size: 23rpx; }
.page-state button::after { border: 0; }
