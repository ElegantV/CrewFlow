page { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; width: 100%; height: 0; box-sizing: border-box; }
.situation-page { padding-top: 24rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.calendar-card { padding: 28rpx 20rpx 20rpx; }
.calendar-head { display: flex; align-items: center; justify-content: space-between; padding: 0 10rpx 2rpx; }
.month-copy { display: flex; flex-direction: column; }
.month-title { color: #172033; font-size: 34rpx; font-weight: 700; }
.scroll-hint { margin-top: 7rpx; color: #9aa5b3; font-size: 20rpx; }
.today-button { display: flex; align-items: center; justify-content: center; width: auto; height: 58rpx; margin: 0; padding: 0 24rpx; box-sizing: border-box; border-radius: var(--r-pill); color: var(--brand); background: var(--c-info-bg); font-size: 22rpx; }
.today-button::after { border: 0; }
.month-nav { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 0 8rpx; }
.calendar-nav { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: var(--r-sm); color: #64748b; background: var(--c-bg-soft); font-size: 34rpx; }
.calendar-title { color: #263244; font-size: 28rpx; font-weight: 700; }
.week-row, .month-grid { display: flex; flex-direction: row; flex-wrap: wrap; }
.week-row { margin-top: 24rpx; padding: 14rpx 0; border-top: 1rpx solid var(--c-border-soft); border-bottom: 1rpx solid var(--c-border); }
.week-label { width: 14.2857%; color: #8a96a6; font-size: 22rpx; text-align: center; }
.calendar-cell { display: flex; width: 14.2857%; height: 98rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: var(--r-md); box-sizing: border-box; }
.calendar-cell--empty { opacity: 0; }
.calendar-cell--selected { border: 1rpx solid #bdd5ff; background: var(--c-brand-tint); }
.day-number { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; color: #263244; font-size: 26rpx; }
.day-number--today { color: #fff; border-radius: 50%; background: var(--brand); font-weight: 700; }
.day-markers { display: flex; flex-direction: row; height: 28rpx; margin-top: 2rpx; }
.day-marker { margin: 0 2rpx; padding: 1rpx 5rpx; border-radius: var(--r-xs); font-size: 18rpx; line-height: 24rpx; }
.day-marker--leave { color: var(--c-danger); background: var(--c-danger-bg-strong); }
.day-marker--overtime { color: var(--c-success); background: var(--c-success-bg-strong); }
.legend { display: flex; justify-content: center; margin-top: 16rpx; color: #7b8797; font-size: 21rpx; }
.legend-item { display: flex; align-items: center; }
.legend-item + .legend-item { margin-left: 28rpx; }
.legend-dot { width: 12rpx; height: 12rpx; margin-right: 6rpx; border-radius: 50%; }
.legend-dot--leave { background: #f43f5e; }
.legend-dot--overtime { background: #10b981; }
.detail-title { display: flex; align-items: baseline; justify-content: space-between; margin: 28rpx 4rpx 16rpx; color: #172033; font-size: 30rpx; font-weight: 700; }
.detail-count { color: #8a96a6; font-size: 21rpx; font-weight: 400; }
.detail-section { margin-top: 22rpx; }
.detail-section-title { display: flex; justify-content: space-between; margin: 0 4rpx 12rpx; color: #455267; font-size: 25rpx; font-weight: 700; }
.detail-section-count { color: #8a96a6; font-weight: 400; }
.person-card { display: flex; align-items: center; margin-bottom: 12rpx; padding: 20rpx; }
.person-avatar { flex-shrink: 0; width: 76rpx; height: 76rpx; border-radius: var(--r-lg); }
.person-avatar--empty { display: flex; align-items: center; justify-content: center; color: #fff; background: #7c9cf5; font-size: 30rpx; font-weight: 700; }
.person-main { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 18rpx; }
.person-name-row { display: flex; align-items: center; }
.person-name { color: #172033; font-size: 27rpx; font-weight: 700; }
.pending-tag { margin-left: 12rpx; padding: 4rpx 10rpx; border-radius: var(--r-xs); color: var(--c-warning); background: var(--c-warning-bg-strong); font-size: 20rpx; }
.person-sub { overflow: hidden; margin-top: 8rpx; color: #7b8797; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.system-tag { max-width: 170rpx; margin-left: 12rpx; padding: 7rpx 10rpx; overflow: hidden; border-radius: var(--r-xs); color: var(--brand-deep); background: var(--c-info-bg); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.empty, .loading-state { padding: 72rpx 24rpx; color: var(--c-text-muted); text-align: center; }
.error-state { display: flex; align-items: center; justify-content: center; padding: 44rpx 24rpx; color: var(--c-danger); font-size: 23rpx; }
.error-state button { margin: 0 0 0 18rpx; padding: 0 16rpx; color: var(--brand); background: var(--c-info-bg); font-size: 22rpx; }
.error-state button::after { border: 0; }