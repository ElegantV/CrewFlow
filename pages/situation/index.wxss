page { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; width: 100%; height: 0; }
.situation-page { padding-top: 24rpx; padding-bottom: 40rpx; }
.calendar-card { padding: 28rpx 20rpx 20rpx; overflow: hidden; }
.calendar-head { display: flex; align-items: center; justify-content: space-between; padding: 0 10rpx 2rpx; }
.month-copy { display: flex; flex-direction: column; }
.month-title { color: #172033; font-size: 34rpx; font-weight: 700; }
.scroll-hint { margin-top: 7rpx; color: #9aa5b3; font-size: 20rpx; }
.today-button { display: flex; align-items: center; justify-content: center; width: auto; height: 58rpx; margin: 0; padding: 0 24rpx; box-sizing: border-box; border-radius: 999rpx; color: #1677ff; background: #edf5ff; font-size: 22rpx; }
.today-button::after { border: 0; }
.week-row, .month-grid { display: flex; flex-direction: row; flex-wrap: wrap; }
.week-row { margin-top: 24rpx; padding: 14rpx 0; border-top: 1rpx solid #f0f2f5; border-bottom: 1rpx solid #edf0f5; }
.week-label { width: 14.2857%; color: #8a96a6; font-size: 22rpx; text-align: center; }
.months-scroll { width: 100%; height: 660rpx; background: #fff; }
.month-section { padding: 28rpx 0 22rpx; border-bottom: 1rpx solid #f0f2f5; }
.month-section-title { display: block; margin-bottom: 12rpx; color: #263244; font-size: 27rpx; font-weight: 700; text-align: center; }
.calendar-cell { display: flex; width: 14.2857%; height: 98rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 18rpx; box-sizing: border-box; }
.calendar-cell--empty { opacity: 0; }
.calendar-cell--selected { border: 1rpx solid #bdd5ff; background: #eaf2ff; }
.day-number { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; color: #263244; font-size: 26rpx; }
.day-number--today { color: #fff; border-radius: 50%; background: #1677ff; font-weight: 700; }
.day-markers { display: flex; flex-direction: row; height: 23rpx; margin-top: 2rpx; }
.day-marker { margin: 0 2rpx; padding: 1rpx 5rpx; border-radius: 6rpx; font-size: 15rpx; line-height: 20rpx; }
.day-marker--leave { color: #be123c; background: #ffe4e6; }
.day-marker--overtime { color: #047857; background: #d1fae5; }
.legend { display: flex; justify-content: center; margin-top: 16rpx; color: #7b8797; font-size: 21rpx; }
.legend-item { display: flex; align-items: center; }
.legend-item + .legend-item { margin-left: 28rpx; }
.legend-dot { width: 12rpx; height: 12rpx; margin-right: 6rpx; border-radius: 50%; }
.legend-dot--leave { background: #f43f5e; }
.legend-dot--overtime { background: #10b981; }
.detail-title { display: flex; align-items: baseline; justify-content: space-between; margin: 28rpx 4rpx 16rpx; color: #172033; font-size: 30rpx; font-weight: 700; }
.detail-count { color: #8a96a6; font-size: 21rpx; font-weight: 400; }
.detail-section { margin-top: 22rpx; }
.detail-section-title { display: flex; justify-content: space-between; margin: 0 4rpx 12rpx; color: #455267; font-size: 25rpx; font-weight: 700; }
.detail-section-count { color: #8a96a6; font-weight: 400; }
.person-card { display: flex; align-items: center; margin-bottom: 12rpx; padding: 20rpx; }
.person-avatar { flex-shrink: 0; width: 76rpx; height: 76rpx; border-radius: 22rpx; }
.person-avatar--empty { display: flex; align-items: center; justify-content: center; color: #fff; background: #7c9cf5; font-size: 20rpx; }
.person-main { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 18rpx; }
.person-name { color: #172033; font-size: 27rpx; font-weight: 700; }
.person-sub { overflow: hidden; margin-top: 8rpx; color: #7b8797; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.system-tag { max-width: 170rpx; margin-left: 12rpx; padding: 7rpx 10rpx; overflow: hidden; border-radius: 9rpx; color: #2563eb; background: #eff6ff; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.empty, .loading-state { padding: 72rpx 24rpx; color: #718096; text-align: center; }
.error-state { display: flex; align-items: center; justify-content: center; padding: 44rpx 24rpx; color: #b42318; font-size: 23rpx; }
.error-state button { margin: 0 0 0 18rpx; padding: 0 16rpx; color: #1677ff; background: #eff6ff; font-size: 22rpx; }
.error-state button::after { border: 0; }
