<navigation-bar title="加班" color="#1F2329" background="#F7F8FA"></navigation-bar>
<scroll-view class="scrollarea" scroll-y>
  <view class="page-shell">
    <view class="summary card">
      <text class="summary-label">可用调休额度</text>
      <view class="summary-balance"><text class="summary-value">{{availableHours}}</text><text class="summary-unit">小时</text></view>
      <text class="summary-note" wx:if="{{nearestExpiry}}">最早一笔将在 {{nearestExpiry}} 到期</text>
      <text class="summary-note" wx:else>暂无可用调休额度</text>
    </view>

    <view class="rule-tip"><text class="rule-tag">规则</text><text class="rule-text">选择下班时间与加班时长（2 至 6 个整小时），实际加班时间以此为准；加班发生后三个月内可补录，额度自加班日起三个月有效。</text></view>

    <view class="ledger-entry card" bindtap="openLedger">
      <view class="ledger-entry-icon">记</view>
      <view class="ledger-entry-body">
        <text class="ledger-entry-title">月度记录</text>
        <text class="ledger-entry-sub">按月查看请假与加班明细</text>
      </view>
      <text class="ledger-entry-arrow">›</text>
    </view>

    <view class="section-head">
      <text class="section-title">加班记录</text>
      <text class="section-count">{{records.length}} 条</text>
    </view>

    <view class="record-list" wx:if="{{records.length}}">
      <view class="record card" wx:for="{{records}}" wx:key="id">
        <view class="record-head">
          <text class="record-date">{{item.date}}</text>
          <text class="status status--{{item.status}}">{{item.statusLabel}}</text>
        </view>
        <text class="record-content">{{item.content}}</text>
        <text class="record-meta">{{item.metaText}}</text>
        <text class="record-expiry" wx:if="{{item.status === 'active' || item.status === 'consumed' || item.status === 'expired'}}">有效期至 {{item.expiresAt}}</text>
        <button wx:if="{{item.canRevoke}}" class="text-button" data-id="{{item.id}}" bindtap="revoke">{{item.status === 'pending' ? '撤回' : '撤销'}}</button>
      </view>
    </view>
    <view class="loading" wx:elif="{{loading}}">加载中…</view>
    <view class="list-error card" wx:elif="{{loadError}}">
      <text>{{loadError}}</text>
      <button class="list-retry" bindtap="loadData">重新加载</button>
    </view>
    <view class="empty card" wx:else>
      <text class="empty-title">暂无加班记录</text>
      <text class="muted">可登记今天或补录三个月内的加班。</text>
    </view>

  </view>
</scroll-view>

<view class="action-bar">
  <button class="primary-button action-button" bindtap="openForm">新增加班</button>
</view>

<view class="modal-mask" wx:if="{{showForm}}" bindtap="closeForm">
  <view class="form-card" catchtap="noop">
    <scroll-view class="form-scroll" scroll-y>
      <view class="form-content">
        <view class="sheet-handle"></view>
        <view class="sheet-head"><text class="form-title">登记加班</text><text class="sheet-close" bindtap="closeForm">关闭</text></view>
        <view class="field">
          <text class="field-label">加班日期</text>
          <picker mode="date" value="{{form.date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onDateChange">
            <view class="field-control">{{form.date}}</view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">下班时间</text>
          <picker mode="time" value="{{form.offTime}}" bindchange="onOffTimeChange">
            <view class="field-control">{{form.offTime}}</view>
          </picker>
        </view>
        <view class="field">
          <text class="field-label">加班时长</text>
          <picker range="{{hoursOptions}}" value="{{form.hoursIndex}}" bindchange="onHoursChange">
            <view class="field-control">{{hoursOptions[form.hoursIndex]}} 小时</view>
          </picker>
          <text class="field-help">实际加班时间以此为准。</text>
        </view>
        <view class="field">
          <text class="field-label">工作内容</text>
          <textarea class="field-textarea" maxlength="200" value="{{form.content}}" placeholder="请填写加班工作内容" bindinput="onContentInput"></textarea>
        </view>
        <view class="form-actions">
          <button class="secondary-button" bindtap="closeForm">取消</button>
          <button class="primary-button" loading="{{submitting}}" bindtap="submit">确认登记</button>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
