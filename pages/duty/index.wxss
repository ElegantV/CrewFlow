page { height: 100vh; display: flex; flex-direction: column; }
.summary { display: flex; flex-direction: column; padding: 32rpx; border-color: var(--c-brand-tint); background: linear-gradient(145deg, var(--c-brand-tint), #ffffff 78%); }
.summary-label { color: var(--c-text-sub); font-size: 24rpx; }
.summary-balance { display: flex; align-items: baseline; margin-top: 6rpx; }
.summary-value { color: var(--brand); font-size: 68rpx; font-weight: 700; line-height: 1.2; }
.summary-unit { margin-left: 8rpx; color: var(--brand); font-size: 24rpx; font-weight: 600; }
.summary-note { margin-top: 10rpx; color: var(--c-text-muted); font-size: 24rpx; }
.rule-tip { display: flex; align-items: flex-start; margin: 20rpx 0 32rpx; padding: 20rpx 22rpx; border-radius: var(--r-md); color: var(--c-warning); background: var(--c-warning-bg); font-size: 24rpx; line-height: 1.55; }
.rule-tag { flex-shrink: 0; margin-right: 14rpx; padding: 2rpx 10rpx; border-radius: var(--r-xs); color: var(--c-warning); background: var(--c-warning-bg-strong); font-size: 20rpx; }
.rule-text { flex: 1; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 0 4rpx 18rpx; }
.section-title { font-size: 28rpx; font-weight: 700; }
.section-count { color: var(--c-text-muted); font-size: 20rpx; }
.record-list { display: flex; flex-direction: column; }
.record { display: flex; flex-direction: column; margin-bottom: 16rpx; padding: 26rpx; }
.record-head { display: flex; align-items: center; justify-content: space-between; }
.record-date { font-size: 28rpx; font-weight: 700; }
.status { padding: 6rpx 14rpx; border-radius: var(--r-pill); color: var(--brand-deep); background: var(--c-info-bg); font-size: 20rpx; }
.status--consumed, .status--expired, .status--revoked { color: var(--c-text-muted); background: var(--c-neutral-bg); }
.record-content { margin-top: 18rpx; font-size: 28rpx; font-weight: 500; }
.record-meta, .record-expiry, .record-reject { margin-top: 10rpx; color: var(--c-text-muted); font-size: 24rpx; }
.record-reject { color: var(--c-danger); }
.text-button { align-self: flex-end; margin: 16rpx 0 0; color: var(--c-danger); line-height: 2; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx 32rpx; text-align: center; }
.empty-title { margin-bottom: 12rpx; font-size: 28rpx; font-weight: 700; }
.empty .muted, .loading { color: var(--c-text-muted); font-size: 24rpx; text-align: center; }
.ledger-entry { display: flex; align-items: center; margin: 28rpx 0 32rpx; padding: 24rpx 26rpx; }
.ledger-entry-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 64rpx; height: 64rpx; border-radius: var(--r-md); color: #fff; background: var(--brand-ai-to); font-size: 24rpx; font-weight: 700; }
.ledger-entry-body { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 20rpx; }
.ledger-entry-title { font-size: 28rpx; font-weight: 700; }
.ledger-entry-sub { margin-top: 6rpx; color: var(--c-text-muted); font-size: 20rpx; }
.ledger-entry-arrow { color: var(--c-text-faint); font-size: 32rpx; }
.action-bar { flex-shrink: 0; padding: 16rpx 28rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--c-border); background: rgba(255, 255, 255, .96); box-sizing: border-box; }
.action-button { width: 100%; margin: 0; }
.form-card { width: 100%; max-height: 88vh; overflow: hidden; border-radius: var(--r-xl) var(--r-xl) 0 0; background: #fff; box-sizing: border-box; }
.form-scroll { width: 100%; max-height: 88vh; }
.form-content { padding: 16rpx 32rpx 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.form-title { display: block; font-size: 32rpx; font-weight: 700; }
.field-input { height: 82rpx; line-height: 82rpx; padding: 0 24rpx; }
.field-textarea { width: 100%; height: 160rpx; }
.form-actions { display: flex; flex-direction: row; margin-top: 32rpx; }
.form-actions button { flex: 1; margin: 0; }
.form-actions button + button { margin-left: 20rpx; }

.field-help--danger { color: var(--c-danger); font-weight: 600; }
