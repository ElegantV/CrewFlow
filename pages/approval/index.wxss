page { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; width: 100%; height: 0; box-sizing: border-box; }
.page-shell { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.approval-list { display: flex; flex-direction: column; }
.approval-card { display: flex; flex-direction: column; margin-bottom: 20rpx; padding: 28rpx; }
.approval-head { display: flex; justify-content: space-between; align-items: center; }
.applicant { font-size: 30rpx; font-weight: 700; }
.type { padding: 6rpx 14rpx; border-radius: var(--r-pill); color: var(--brand-deep); background: var(--c-info-bg); font-size: 22rpx; }
.date { margin-top: 20rpx; font-size: 27rpx; }
.meta, .reason { margin-top: 10rpx; color: var(--c-text-muted); font-size: 23rpx; line-height: 1.5; }
.actions { display: flex; flex-direction: row; margin-top: 24rpx; }
.actions button { flex: 1; margin: 0; }
.actions button + button { margin-left: 20rpx; }
.reject-button, .approve-button { border-radius: var(--r-md); font-size: 26rpx; }
.reject-button { color: var(--c-danger); background: var(--c-danger-bg); }
.approve-button { color: #fff; background: #059669; }
.reject-button::after, .approve-button::after { border: 0; }
.empty, .loading { padding: 80rpx 24rpx; color: var(--c-text-muted); text-align: center; }
.section-title { margin: 36rpx 0 18rpx; color: #475569; font-size: 26rpx; font-weight: 700; }
.history-list { margin-bottom: 24rpx; }
.type--approved { color: var(--c-success); background: var(--c-success-bg); }

.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(15, 23, 42, .48); }
.detail-sheet { width: 100%; border-radius: var(--r-xl) var(--r-xl) 0 0; background: #fff; box-sizing: border-box; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 22rpx; border-radius: var(--r-pill); background: #d8dce3; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 0 32rpx; margin-bottom: 8rpx; }
.sheet-title { font-size: 34rpx; font-weight: 700; }
.sheet-close { padding: 8rpx 0 8rpx 20rpx; color: #8a9099; font-size: 25rpx; }
.detail-body { margin: 0 32rpx; border-radius: var(--r-md); background: var(--c-bg-subtle); overflow: hidden; }
.detail-row { display: flex; flex-direction: row; padding: 20rpx 24rpx; }
.detail-row + .detail-row { border-top: 1rpx solid #eef1f5; }
.detail-label { width: 160rpx; flex-shrink: 0; color: #8a96a6; font-size: 25rpx; }
.detail-value { flex: 1; color: #263244; font-size: 26rpx; line-height: 1.5; word-break: break-all; }
.detail-actions { display: flex; flex-direction: row; margin: 28rpx 32rpx 0; }
.detail-actions button { flex: 1; margin: 0; }
.detail-actions button + button { margin-left: 20rpx; }

.history-empty { padding: 36rpx 24rpx; color: var(--c-text-muted); font-size: 23rpx; text-align: center; }
