<navigation-bar title="审批中心" color="#1F2329" background="#F7F8FA"></navigation-bar>
<scroll-view class="scrollarea" scroll-y>
  <view class="page-shell">
    <view class="approval-group" wx:if="{{overtimeApprovals.length}}">
      <view class="group-title"><text class="group-dot group-dot--overtime"></text><text>加班申请</text><text class="group-count">{{overtimeApprovals.length}}</text></view>
      <view class="approval-card card" wx:for="{{overtimeApprovals}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
        <view class="approval-head">
          <text class="applicant">{{item.applicant.name || '未命名用户'}}</text>
          <text class="type type--overtime">加班</text>
        </view>
        <text class="date">{{item.date}}</text>
        <text class="meta">加班 {{item.hours}} 小时</text>
        <view class="actions">
          <button class="reject-button" data-id="{{item.id}}" disabled="{{decidingId}}" loading="{{decidingId === item.id}}" catchtap="reject">驳回</button>
          <button class="approve-button" data-id="{{item.id}}" disabled="{{decidingId}}" loading="{{decidingId === item.id}}" catchtap="approve">通过</button>
        </view>
      </view>
    </view>
    <view class="approval-group" wx:if="{{leaveApprovals.length}}">
      <view class="group-title"><text class="group-dot group-dot--leave"></text><text>请假申请</text><text class="group-count">{{leaveApprovals.length}}</text></view>
      <view class="approval-card card" wx:for="{{leaveApprovals}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
        <view class="approval-head">
          <text class="applicant">{{item.applicant.name || '未命名用户'}}</text>
          <text class="type">{{item.leaveTypeLabel}}</text>
        </view>
        <text class="date">{{item.startDate}} 至 {{item.endDate}}</text>
        <text class="meta">{{item.requestedDays}}天 / {{item.requestedHours}}小时 · 代理人 {{item.agentName || '—'}}</text>
        <text class="reason" wx:if="{{item.reason}}">事由：{{item.reason}}</text>
        <view class="actions">
          <button class="reject-button" data-id="{{item.id}}" disabled="{{decidingId}}" loading="{{decidingId === item.id}}" catchtap="reject">驳回</button>
          <button class="approve-button" data-id="{{item.id}}" disabled="{{decidingId}}" loading="{{decidingId === item.id}}" catchtap="approve">通过</button>
        </view>
      </view>
    </view>
    <view class="empty card" wx:elif="{{!loading && !loadError}}">暂无待审批申请</view>
    <view class="loading" wx:elif="{{loading && !loadError}}">加载中…</view>
    <view class="list-error card" wx:elif="{{loadError}}">
      <text>{{loadError}}</text>
      <button class="list-retry" bindtap="loadData">重新加载</button>
    </view>

    <view class="section-title" wx:if="{{!loading && !loadError}}">最近通过</view>
    <view class="approval-list history-list" wx:if="{{history.length}}">
      <view class="approval-card card" wx:for="{{history}}" wx:key="id">
        <view class="approval-head">
          <text class="applicant">{{item.applicantName || '未命名用户'}}</text>
          <text class="type type--approved">已通过 · {{item.bizType === 'overtime' ? '加班' : item.leaveTypeLabel}}</text>
        </view>
        <block wx:if="{{item.bizType === 'overtime'}}">
          <text class="date">{{item.date}}</text>
          <text class="meta">{{item.hours}}小时</text>
        </block>
        <block wx:else>
          <text class="date">{{item.startDate}} 至 {{item.endDate}}</text>
          <text class="meta">{{item.requestedDays}}天 / {{item.requestedHours}}小时</text>
        </block>
      </view>
    </view>
    <view class="history-empty" wx:if="{{!history.length && !loading && !loadError}}">暂无审批历史，处理过的申请会显示在这里。</view>
  </view>
</scroll-view>

<view class="modal-mask" wx:if="{{detail}}" bindtap="closeDetail">
  <view class="detail-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <text class="sheet-title">申请详情</text>
      <text class="sheet-close" bindtap="closeDetail">关闭</text>
    </view>
    <view class="detail-body">
      <view class="detail-row">
        <text class="detail-label">申请人</text>
        <text class="detail-value">{{detail.applicant.name || '未命名用户'}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">{{detail.bizType === 'overtime' ? '类型' : '假别'}}</text>
        <text class="detail-value">{{detail.bizType === 'overtime' ? '加班' : detail.leaveTypeLabel}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">日期</text>
        <text class="detail-value">{{detail.bizType === 'overtime' ? detail.date : detail.startDate + ' 至 ' + detail.endDate}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">时长</text>
        <text class="detail-value">{{detail.bizType === 'overtime' ? detail.hours + '小时' : detail.requestedDays + '天 / ' + detail.requestedHours + '小时'}}</text>
      </view>
      <view class="detail-row" wx:if="{{detail.bizType !== 'overtime' && detail.agentName}}">
        <text class="detail-label">代理人</text>
        <text class="detail-value">{{detail.agentName}}</text>
      </view>
      <view class="detail-row" wx:if="{{detail.bizType === 'overtime'}}">
        <text class="detail-label">内容</text>
        <text class="detail-value">{{detail.content}}</text>
      </view>
      <view class="detail-row" wx:if="{{detail.bizType !== 'overtime' && detail.reason}}">
        <text class="detail-label">事由</text>
        <text class="detail-value">{{detail.reason}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">提交时间</text>
        <text class="detail-value">{{detail.submittedTime}}</text>
      </view>
    </view>
    <view class="detail-actions">
      <button class="reject-button" data-id="{{detail.id}}" disabled="{{decidingId}}" loading="{{decidingId === detail.id}}" bindtap="reject">驳回</button>
      <button class="approve-button" data-id="{{detail.id}}" disabled="{{decidingId}}" loading="{{decidingId === detail.id}}" bindtap="approve">通过</button>
    </view>
  </view>
</view>
