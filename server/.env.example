# 本地开发保持 development;生产部署必须改为 production(否则 dev 测试登录等接口会暴露)。
# config.ts 的兜底默认值是 production。
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://crewflow:change-me@127.0.0.1:5432/crewflow
POSTGRES_USER=crewflow
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=crewflow
JWT_SECRET=replace-with-at-least-32-random-characters
WECHAT_APP_ID=wx9bc0177a7fc91d6a
WECHAT_APP_SECRET=replace-with-wechat-app-secret
BOOTSTRAP_SUPER_ADMIN_OPENID=
CORS_ORIGINS=https://servicewechat.com
PDF_COMPANY_NAME=华银数字科技（北京）有限公司
PDF_PROJECT_TEAM=经营分析决策
PDF_WORK_LOCATION=博瑞
# macOS 和 Docker 会自动查找中文字体；其他系统可在此填写字体绝对路径。
PDF_FONT_PATH=
PDF_FONT_FAMILY=
WXPUSHER_APP_TOKEN=replace-with-wxpusher-app-token

# AI 深度问答：微信小程序后台「开发 → AI 能力」创建的 API Key。
# 留空表示未开通，/api/v1/ai/chat 返回 503；小程序端指令功能不受影响。
AI_API_KEY=
# 默认即微信 OpenAI 兼容网关，一般无需修改。
AI_API_URL=https://chatapi.weixin.qq.com/openai/v1/chat/completions
AI_MODEL=Deepseek-v4-flash
